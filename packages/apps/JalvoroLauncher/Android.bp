// Jalvoro's first AOSP-integrated system app: a lightweight home launcher.
android_app {
    name: "JalvoroLauncher",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    // The launcher needs no privileged permissions; keep it non-privileged.
    privileged: false,
    dex_preopt: {
        enabled: false,
    },
}
