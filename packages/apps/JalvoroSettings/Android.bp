android_app {
    name: "JalvoroSettings",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    // This app only launches public Android settings screens; no privileged access needed.
    privileged: false,
    dex_preopt: {
        enabled: false,
    },
}
